#  before making packaged-app so they need to be ignored
/*.manifest
/*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosenv/
.pytest_cache/
.cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.log

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Docker/Compose local data directories (just in case they are mounted locally)
*data/
*.db
*.sqlite

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS generated files
.DS_Store
Thumbs.db

